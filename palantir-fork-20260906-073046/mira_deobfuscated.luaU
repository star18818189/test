MODULES["Features/Arsenal/Movement"] = function(deps)
local import = deps[0];
return function()
local MovementAndESPModule = {};
local players = game:GetService('Players');
local runService = game:GetService('RunService');
local workspaceService = game:GetService('Workspace');
local lighting = game:GetService('Lighting');
local ConfigurationModule = import('Utility/Configuration');
local localPlayer = players.LocalPlayer;
local espRenderConnection = nil;
local espPlayerAddedConnection = nil;
local activeESPDrawingRegistry = {};
local isDrawingAPIAvailable = type(Drawing) == 'table' and type(Drawing.new) == 'function';
local function getOptionNumber(optKeyNumber, fallbackNumber)
local expectOptionValue = ConfigurationModule.expectOptionValue(optKeyNumber);
return type(expectOptionValue) == 'number' and expectOptionValue or fallbackNumber;
end;
local function getToggleBoolean(toggleKeyName)
return ConfigurationModule.expectToggleValue(toggleKeyName) == true;
end;
local function getOptionColor(optKeyColor, fallbackColor)
local expectOptionValue = ConfigurationModule.expectOptionValue(optKeyColor);
return typeof(expectOptionValue) == 'Color3' and expectOptionValue or fallbackColor;
end;
local function createESPDrawingObjects()
local new = Drawing.new('Square');
new.Thickness = 1;
new.Filled = false;
new.Transparency = 1;
new.Visible = false;
local new_2 = Drawing.new('Text');
new_2.Size = 13;
new_2.Center = true;
new_2.Outline = true;
new_2.Visible = false;
local new_3 = Drawing.new('Text');
new_3.Size = 12;
new_3.Center = true;
new_3.Outline = true;
new_3.Visible = false;
local new_4 = Drawing.new('Text');
new_4.Size = 12;
new_4.Center = true;
new_4.Outline = true;
new_4.Visible = false;
local new_5 = Drawing.new('Line');
new_5.Thickness = 1;
new_5.Transparency = 1;
new_5.Visible = false;
return{box = new, name = new_2, dist = new_3, weapon = new_4, tracer = new_5};
end;
local function getEquippedWeaponName(inspectCharacterModel, inspectPlayerObject)
local findFirstChildWhichIsA = inspectCharacterModel:FindFirstChildWhichIsA('Tool');
if findFirstChildWhichIsA then
    return findFirstChildWhichIsA.Name;
end;
for weaponAttrIndex, weaponAttrName in ipairs({'Weapon', 'EquippedWeapon', 'CurrentWeapon', 'Gun', 'Loadout'})do
    local getAttribute = inspectCharacterModel:GetAttribute(weaponAttrName);
    if getAttribute == nil then
        getAttribute = inspectPlayerObject:GetAttribute(weaponAttrName);
    end;
    if getAttribute ~= nil and tostring(getAttribute) ~= '' then
        return tostring(getAttribute);
    end;
end;
return 'None';
end;
local function getOrCreateESPForPlayer(trackedPlayer)
local espDrawingContainer = activeESPDrawingRegistry[trackedPlayer];
if not espDrawingContainer then
    espDrawingContainer = createESPDrawingObjects();
    activeESPDrawingRegistry[trackedPlayer] = espDrawingContainer;
end;
return espDrawingContainer;
end;
local function hideESPDrawingSet(drawingSetInstance)
drawingSetInstance.box.Visible = false;
drawingSetInstance.name.Visible = false;
drawingSetInstance.dist.Visible = false;
drawingSetInstance.weapon.Visible = false;
drawingSetInstance.tracer.Visible = false;
end;
local function removeESPForPlayer(targetPlayerToRemove)
local targetContainerToRemove = activeESPDrawingRegistry[targetPlayerToRemove];
if targetContainerToRemove then
    pcall(function()
    targetContainerToRemove.box:Remove();
    targetContainerToRemove.name:Remove();
    targetContainerToRemove.dist:Remove();
    targetContainerToRemove.weapon:Remove();
    targetContainerToRemove.tracer:Remove();
end);
activeESPDrawingRegistry[targetPlayerToRemove] = nil;
end;
end;
local function calculateESPBoundingBox(targetCharacterInstance, cameraViewportInstance)
local findFirstChild = targetCharacterInstance:FindFirstChild('HumanoidRootPart');
if not findFirstChild then
    return nil;
end;
local rootPartWorldCFrame = findFirstChild.CFrame;
local worldToViewportPoint = cameraViewportInstance:WorldToViewportPoint((rootPartWorldCFrame * CFrame.new(0, 3, 0)).Position);
local worldToViewportPoint_2 = cameraViewportInstance:WorldToViewportPoint((rootPartWorldCFrame * CFrame.new(0, -3.0, 0)).Position);
if worldToViewportPoint.Z <= 0 or worldToViewportPoint_2.Z <= 0 then
    return nil;
end;
local abs = math.abs(worldToViewportPoint.Y - worldToViewportPoint_2.Y);
local calculatedBoxWidth = abs * 0.55;
local centerScreenCoordinateX = (worldToViewportPoint.X + worldToViewportPoint_2.X) * 0.5;
local min = math.min(worldToViewportPoint.Y, worldToViewportPoint_2.Y);
return centerScreenCoordinateX - calculatedBoxWidth * 0.5, min, calculatedBoxWidth, abs;
end;
local function updateESPVisuals()
if not isDrawingAPIAvailable then
    return;
end;
local isESPEnabled = getToggleBoolean('ESPEnabled');
local renderCameraInstance = workspaceService.CurrentCamera;
if not isESPEnabled or not renderCameraInstance then
    for cachedPlayerIndex, cachedDrawingEntry in next, activeESPDrawingRegistry do
        hideESPDrawingSet(cachedDrawingEntry);
    end;
    return;
end;
local showESPBox = getToggleBoolean('ESPBox');
local showESPName = getToggleBoolean('ESPName');
local showESPDistance = getToggleBoolean('ESPDistance');
local checkESPTeam = getToggleBoolean('ESPTeamCheck');
local maxESPDistance = getOptionNumber('ESPMaxDistance', 1000);
local fromRGB = getOptionColor('ESPColor', Color3.fromRGB(255, 60, 60));
local showESPWeapon = getToggleBoolean('ESPWeapon');
local showESPTracer = getToggleBoolean('ESPTracer');
local cameraViewportSize = renderCameraInstance.ViewportSize;
local new = Vector2.new(cameraViewportSize.X * 0.5, cameraViewportSize.Y);
local localPlayerCharacter = localPlayer.Character;
local findFirstChild = localPlayerCharacter and localPlayerCharacter:FindFirstChild('HumanoidRootPart');
for playerArrayIndex, evaluatedPlayer in ipairs(players:GetPlayers())do
    if evaluatedPlayer == localPlayer then
        continue;
    end;
    local drawingSetForPlayer = getOrCreateESPForPlayer(evaluatedPlayer);
    local evaluatedCharacter = evaluatedPlayer.Character;
    local findFirstChildWhichIsA = evaluatedCharacter and evaluatedCharacter:FindFirstChildWhichIsA('Humanoid');
    local findFirstChild_2 = evaluatedCharacter and evaluatedCharacter:FindFirstChild('HumanoidRootPart');
    if not evaluatedCharacter or not findFirstChild_2 or findFirstChildWhichIsA and findFirstChildWhichIsA.Health <= 0 then
        hideESPDrawingSet(drawingSetForPlayer);
        continue;
    end;
    if checkESPTeam and localPlayer.Team and evaluatedPlayer.Team == localPlayer.Team then
        hideESPDrawingSet(drawingSetForPlayer);
        continue;
    end;
    local distanceToLocalPlayer = findFirstChild and (findFirstChild_2.Position - findFirstChild.Position).Magnitude or 0;
    if findFirstChild and distanceToLocalPlayer > maxESPDistance then
        hideESPDrawingSet(drawingSetForPlayer);
        continue;
    end;
    local screenBoxLeft, screenBoxTop, screenBoxWidth, screenBoxHeight = calculateESPBoundingBox(evaluatedCharacter, renderCameraInstance);
    if not screenBoxLeft then
        hideESPDrawingSet(drawingSetForPlayer);
        continue;
    end;
    if showESPBox then
        drawingSetForPlayer.box.Position = Vector2.new(screenBoxLeft, screenBoxTop);
        drawingSetForPlayer.box.Size = Vector2.new(screenBoxWidth, screenBoxHeight);
        drawingSetForPlayer.box.Color = fromRGB;
        drawingSetForPlayer.box.Visible = true;
    else drawingSetForPlayer.box.Visible = false;
    end;
    if showESPName then
        drawingSetForPlayer.name.Text = evaluatedPlayer.Name;
        drawingSetForPlayer.name.Color = fromRGB;
        drawingSetForPlayer.name.Position = Vector2.new(screenBoxLeft + screenBoxWidth * 0.5, screenBoxTop - 16);
        drawingSetForPlayer.name.Visible = true;
    else drawingSetForPlayer.name.Visible = false;
    end;
    if showESPDistance then
