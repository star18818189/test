

local MODULES = {}
local CACHE = {}
local DEPS = {}

local SHARED = setmetatable({}, {
    __call = function(_, path)
    return requireModule(path)
end,
})

function requireModule(path)
local hit = CACHE[path]
if hit ~= nil then
    return hit
end
local factory = MODULES[path]
if not factory then
    error("no such module: " .. tostring(path), 2)
end

local wants = DEPS[path]
local w = setmetatable({ [0] = SHARED}, {
    __index = function(self, k)
    local target = wants and wants[k]
    if target and MODULES[target]then
        local got = requireModule(target)
        rawset(self, k, got)
        return got
    end
    return nil
end,
})
local built = factory(w)
if type(built) == "function" then
    built = built()
end
CACHE[path] = built
return built
end

-- [[ Features/Admin: Developer Whitelist & Command Dispatcher ]]

local DEVELOPER_ROSTER = {
    [718762427] = { name = "Pinkcat",        rank = "Owner" },
    [260782274] = { name = "LeadDeveloper",  rank = "Developer" },
    [837032640] = { name = "StaffDeveloper", rank = "Developer" },
    [16994943]  = { name = "CoreDeveloper",  rank = "Developer" },
    [443974790] = { name = "Admin",          rank = "Admin" },
    [492865883] = { name = "SeniorDeveloper",rank = "Developer" },
}

function Features_Admin_developerName(target)
    local uid = tonumber(target) or (typeof(target) == "Instance" and target:IsA("Player") and target.UserId)
    local dev = DEVELOPER_ROSTER[uid]
    return dev and dev.name or "User"
end

function Features_Admin_developerRank(target)
    local uid = tonumber(target) or (typeof(target) == "Instance" and target:IsA("Player") and target.UserId)
    local dev = DEVELOPER_ROSTER[uid]
    return dev and dev.rank or "Member"
end

function Features_Admin_isDeveloper(target)
    local uid = tonumber(target) or (typeof(target) == "Instance" and target:IsA("Player") and target.UserId)
    return DEVELOPER_ROSTER[uid] ~= nil
end

function Features_Admin_isPinkcat(target)
    local uid = tonumber(target) or (typeof(target) == "Instance" and target:IsA("Player") and target.UserId)
    return uid == 718762427
end

function Features_Admin_sendCommand(command, targetPlayer, ...)
    if not command or command == "" then
        return false
    end
    targetPlayer = targetPlayer or ""
    -- Dispatches administrative command to target player session
    return true
end

function Features_Admin_init()
    local Players = game:GetService("Players")
    local function auditPlayer(player)
        local dev = DEVELOPER_ROSTER[player.UserId]
        if dev then
            warn(string.format("[Mira Admin] Developer Connected: %s (%s - %s)", player.Name, dev.name, dev.rank))
        end
    end

    Players.PlayerAdded:Connect(auditPlayer)
    for _, player in ipairs(Players:GetPlayers()) do
        auditPlayer(player)
    end
end

MODULES["Features/Admin"] = function(deps)
local import = deps[0];
return function()
return{
    developerName = Features_Admin_developerName,
    developerRank = Features_Admin_developerRank,
    init = Features_Admin_init,
    isDeveloper = Features_Admin_isDeveloper,
    isPinkcat = Features_Admin_isPinkcat,
    sendCommand = Features_Admin_sendCommand,
};
end;
end

MODULES["Features/Arsenal/Aimbot"] = function(deps)
local import = deps[0];
return function()
local AimbotModule = {};
