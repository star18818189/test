local ExpApBreakerState = {
    enabled = false,
    weightSpoof = false,
    targetWeightSpoof = false,
    priorityChanger = false,
    attackDelay = false,
    connections = {},
    activeHooks = {},
}

function Features_Combat_ExpApBreaker_Start(self)
    Features_Combat_ExpApBreaker_startExpApBreaker()
end

function Features_Combat_ExpApBreaker_Stop(self)
    Features_Combat_ExpApBreaker_stopExpApBreaker()
end

function Features_Combat_ExpApBreaker_startExpApBreaker()
    if ExpApBreakerState.enabled then return end
    ExpApBreakerState.enabled = true

    local Players = game:GetService("Players")
    local localPlayer = Players.LocalPlayer
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid", 5)

    -- Hook active swing animations to bypass opponent Auto-Parry detection
    if humanoid then
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if animator then
            local conn = animator.AnimationPlayed:Connect(function(track)
                if not ExpApBreakerState.enabled then return end
                -- Apply priority change if enabled
                if ExpApBreakerState.priorityChanger then
                    pcall(function()
                        track.Priority = Enum.AnimationPriority.Core
                    end)
                end
                -- Apply weight spoof if enabled
                if ExpApBreakerState.weightSpoof then
                    pcall(function()
                        track:AdjustWeight(0.001)
                    end)
                end
            end)
            table.insert(ExpApBreakerState.connections, conn)
        end
    end

    warn("[Mira Combat] Auto-Parry Breaker activated.")
end

function Features_Combat_ExpApBreaker_stopExpApBreaker()
    ExpApBreakerState.enabled = false
    for _, conn in ipairs(ExpApBreakerState.connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(ExpApBreakerState.connections)
    warn("[Mira Combat] Auto-Parry Breaker deactivated.")
end

