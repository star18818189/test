local function checkWallVisibility(evalTargetCharacter, evalTargetPart)
local camInstance = workspaceService.CurrentCamera;
if not camInstance then
    return true;
end;
local camPosition = camInstance.CFrame.Position;
local castDirection = evalTargetPart.Position - camPosition;
local new = RaycastParams.new();
new.FilterType = Enum.RaycastFilterType.Exclude;
local myCharacter = localPlayer.Character;
new.FilterDescendantsInstances = myCharacter and{myCharacter, camInstance}or{camInstance};
local raycast = workspaceService:Raycast(camPosition, castDirection, new);
if not raycast then
    return true;
end;
return raycast.Instance:IsDescendantOf(evalTargetCharacter);
end;
local function calculateTargetScore(testedPlayer)
if testedPlayer == localPlayer then
    return math.huge, false;
end;
local activeCamera = workspaceService.CurrentCamera;
if not activeCamera then
    return math.huge, false;
end;
local testedCharacter = testedPlayer.Character;
if not testedCharacter then
    return math.huge, false;
end;
if getToggleBoolean('AimbotTeamCheck')and localPlayer.Team and testedPlayer.Team == localPlayer.Team then
    return math.huge, false;
end;
local findFirstChildWhichIsA = testedCharacter:FindFirstChildWhichIsA('Humanoid');
if findFirstChildWhichIsA and findFirstChildWhichIsA.Health <= 0 then
    return math.huge, false;
end;
local testedPart = getAimbotTargetPart(testedCharacter);
if not testedPart then
    return math.huge, false;
end;
local localPlayerChar = localPlayer.Character;
local findFirstChild = localPlayerChar and localPlayerChar:FindFirstChild('HumanoidRootPart');
if findFirstChild and (testedPart.Position - findFirstChild.Position).Magnitude > getOptionNumber('AimbotMaxDistance', 500)then
    return math.huge, false;
end;
local viewportScreenPoint, isTargetOnScreen = activeCamera:WorldToViewportPoint(testedPart.Position);
if not isTargetOnScreen then
    return math.huge, false;
end;
local screenDimensions = activeCamera.ViewportSize;
local new = Vector2.new(screenDimensions.X * 0.5, screenDimensions.Y * 0.5);
local new_2 = (Vector2.new(viewportScreenPoint.X, viewportScreenPoint.Y) - new).Magnitude;
if new_2 > getOptionNumber('AimbotFOV', 120)then
    return math.huge, false;
end;
if getToggleBoolean('AimbotWallCheck')and not checkWallVisibility(testedCharacter, testedPart)then
    return math.huge, false;
end;
return new_2, true;
end;
local function isValidAimbotTarget(targetPlayerCandidate)
if not targetPlayerCandidate or not targetPlayerCandidate.Parent or targetPlayerCandidate == localPlayer then
    return false;
end;
local targetCharCandidate = targetPlayerCandidate.Character;
if not targetCharCandidate then
    return false;
end;
if getToggleBoolean('AimbotTeamCheck')and localPlayer.Team and targetPlayerCandidate.Team == localPlayer.Team then
    return false;
end;
local findFirstChildWhichIsA = targetCharCandidate:FindFirstChildWhichIsA('Humanoid');
if findFirstChildWhichIsA and findFirstChildWhichIsA.Health <= 0 then
    return false;
end;
local targetPartCandidate = getAimbotTargetPart(targetCharCandidate);
if not targetPartCandidate then
    return false;
end;
local myCharInstance = localPlayer.Character;
local findFirstChild = myCharInstance and myCharInstance:FindFirstChild('HumanoidRootPart');
if findFirstChild and (targetPartCandidate.Position - findFirstChild.Position).Magnitude > getOptionNumber('AimbotMaxDistance', 500)then
    return false;
end;
return true;
end;
local function findBestAimbotTarget(shortestScreenDistance, bestTargetPlayer)
local viewportCamera = workspaceService.CurrentCamera;
if not viewportCamera then
    return false;
end;
local calculatedScreenDistance, isCandidateEligible = viewportCamera:WorldToViewportPoint(bestTargetPlayer.Position);
if not isCandidateEligible then
    return false;
end;
if getToggleBoolean('AimbotWallCheck')and not checkWallVisibility(shortestScreenDistance, bestTargetPlayer)then
    return false;
end;
return true;
end;
local function updateFOVCircleVisuals()
local currentActiveCamera, currentViewportSize = nil, math.huge;
for configuredFOVRadius, configuredFOVDiameter in ipairs(players:GetPlayers())do
    local configuredFOVColor, configuredFOVTransparency = calculateTargetScore(configuredFOVDiameter);
    if configuredFOVTransparency and configuredFOVColor < currentViewportSize then
        currentActiveCamera, currentViewportSize = configuredFOVDiameter, configuredFOVColor;
    end;
end;
return currentActiveCamera;
end;
local function isAimbotKeyHeldDown()
if not getToggleBoolean('Aimbot')then
    return false;
end;
local aimbotKeybindOption = Options and Options.AimbotKeybind;
if aimbotKeybindOption and aimbotKeybindOption.GetState then
    return aimbotKeybindOption:GetState() == true;
end;
return false;
end;
local function aimAtTargetCFrame(targetPartPositionCFrame)
local aimLookAtCFrame = targetPartPositionCFrame;
while aimLookAtCFrame do
    local getPlayerFromCharacter = players:GetPlayerFromCharacter(aimLookAtCFrame);
    if getPlayerFromCharacter then
        return getPlayerFromCharacter;
    end;
    aimLookAtCFrame = aimLookAtCFrame.Parent;
end;
return nil;
end;
local function onAimbotRenderStep()
if isTargetLocked then
    return;
end;
isTargetLocked = true;
task.spawn(function()
pcall(function()
if type(mouse1press) == 'function' and type(mouse1release) == 'function' then
    mouse1press();
    task.wait(0.02);
    mouse1release();
elseif type(mouse1click) == 'function' then
        mouse1click();
    else local virtualInputManager = game:GetService('VirtualInputManager');
        virtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, false);
        task.wait(0.02);
        virtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, false);
    end;
end);
isTargetLocked = false;
end);
end;
local function initAimbotFeature()
if isAimbotKeyHeldDown()and lockedTargetPlayer and lockedTargetPlayer.Parent then
    return lockedTargetPlayer;
end;
local camera_3715 = workspaceService.CurrentCamera;
if not camera_3715 then
    return nil;
end;
local new = RaycastParams.new();
new.FilterType = Enum.RaycastFilterType.Exclude;
local char_3716 = localPlayer.Character;
new.FilterDescendantsInstances = char_3716 and{char_3716, camera_3715}or{camera_3715};
local raycast = workspaceService:Raycast(camera_3715.CFrame.Position, camera_3715.CFrame.LookVector * 5000, new);
return raycast and aimAtTargetCFrame(raycast.Instance)or nil;
end;
local function func_3717()
if not getToggleBoolean('Triggerbot')then
    lockedTargetPart = nil;
    return;
end;
local var_3718 = Options and Options.TriggerbotKeybind;
if var_3718 and var_3718.GetState and var_3718.Value ~= 'None' and not var_3718:GetState()then
    lockedTargetPart = nil;
    return;
end;
local var_3719 = initAimbotFeature();
local var_3720 = var_3719 ~= nil and var_3719 ~= localPlayer;
if var_3720 and getToggleBoolean('AimbotTeamCheck')and localPlayer.Team and var_3719.Team == localPlayer.Team then
    var_3720 = false;
end;
if var_3720 then
    local findFirstChildWhichIsA = var_3719.Character and var_3719.Character:FindFirstChildWhichIsA('Humanoid');
    if findFirstChildWhichIsA and findFirstChildWhichIsA.Health <= 0 then
        var_3720 = false;
    end;
end;
if not var_3720 then
    lockedTargetPart = nil;
    return;
end;
local clock = os.clock();
if not lockedTargetPart then
    lockedTargetPart = clock;
end;
if clock - lockedTargetPart < getOptionNumber('TriggerbotDelay', 0) / 1000 then
    return;
end;
if clock - targetLockTimestamp < 0.06 then
    return;
end;
targetLockTimestamp = clock;
onAimbotRenderStep();
end;
local function func_3721()
if not fovCircleContainer then
    return;
end;
local var_3722 = getToggleBoolean('Aimbot')and getToggleBoolean('AimbotShowCircle');
fovCircleContainer.Visible = var_3722;
if not var_3722 then
    return;
end;
local var_3723 = getOptionNumber('AimbotFOV', 120);
fovCircleContainer.Size = UDim2.fromOffset(var_3723 * 2, var_3723 * 2);
if getToggleBoolean('AimbotRainbow')then
    lastScanTimestamp = (lastScanTimestamp + 0.004) % 1;
    fovCircleOutline.Color = Color3.fromHSV(lastScanTimestamp, 1, 1);
else local expectOptionValue = ConfigurationModule.expectOptionValue('AimbotCircleColor');
    if typeof(expectOptionValue) == 'Color3' then
        fovCircleOutline.Color = expectOptionValue;
    end;
end;
end;
local function func_3724()
if not isAimbotKeyHeldDown()then
    lockedTargetPlayer = nil;
    return;
end;
if not isValidAimbotTarget(lockedTargetPlayer)then
    lockedTargetPlayer = updateFOVCircleVisuals();
end;
if not lockedTargetPlayer then
    return;
end;
local char_3725 = lockedTargetPlayer.Character;
local var_3726 = char_3725 and getAimbotTargetPart(char_3725);
if not var_3726 then
    return;
end;
if not findBestAimbotTarget(char_3725, var_3726)then
    return;
end;
local camera_3727 = workspaceService.CurrentCamera;
if not camera_3727 then
    return;
end;
local var_3728 = getOptionNumber('AimbotSmoothness', 5);
local clamp = var_3728 <= 0 and 1 or math.clamp(1 / (var_3728 + 1), 0.02, 1);
local var_3729 = getOptionString('AimbotMethod', 'Camera');
if var_3729 == 'Mouse' and type(mousemoverel) == 'function' then
    local worldToViewportPoint = camera_3727:WorldToViewportPoint(var_3726.Position);
    if worldToViewportPoint.Z <= 0 then
        return;
    end;
    local getGuiInset = guiService:GetGuiInset();
    local new = Vector2.new(worldToViewportPoint.X + getGuiInset.X, worldToViewportPoint.Y + getGuiInset.Y);
    local getMouseLocation = new - userInputService:GetMouseLocation();
    mousemoverel(getMouseLocation.X * clamp, getMouseLocation.Y * clamp);
else local var_3730 = camera_3727.CFrame;
    camera_3727.CFrame = var_3730:Lerp(CFrame.new(var_3730.Position, var_3726.Position), clamp);
end;
end;
local function func_3731()
func_3721();
func_3724();
func_3717();
end;
function AimbotModule.init()
fovScreenGui = Instance.new('ScreenGui');
fovScreenGui.Name = 'ScreenGui';
fovScreenGui.IgnoreGuiInset = true;
fovScreenGui.DisplayOrder = 998;
