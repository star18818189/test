end;
for partGroupIndex, partNameCandidate in ipairs(candidatePartNames)do
    local findFirstChild = targetModelInstance:FindFirstChild(partNameCandidate);
    if findFirstChild and findFirstChild:IsA('BasePart')then
        return findFirstChild;
