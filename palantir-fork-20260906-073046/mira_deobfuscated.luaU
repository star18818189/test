local workspaceService = game:GetService('Workspace');
local userInputService = game:GetService('UserInputService');
local guiService = game:GetService('GuiService');
local ConfigurationModule = import('Utility/Configuration');
local localPlayer = players.LocalPlayer;
local isAimbotEnabled = false;
local fovScreenGui = nil;
local fovCircleContainer = nil;
local fovCircleOutline = nil;
local lastScanTimestamp = 0;
local lockedTargetPlayer = nil;
local lockedTargetPart = nil;
local targetLockTimestamp = 0;
local isTargetLocked = false;
local function getOptionNumber(optKeyNum, defaultNum)
local expectOptionValue = ConfigurationModule.expectOptionValue(optKeyNum);
return type(expectOptionValue) == 'number' and expectOptionValue or defaultNum;
end;
local function getOptionString(optKeyStr, defaultStr)
local expectOptionValue = ConfigurationModule.expectOptionValue(optKeyStr);
return type(expectOptionValue) == 'string' and expectOptionValue or defaultStr;
end;
local function getToggleBoolean(toggleKeyName)
return ConfigurationModule.expectToggleValue(toggleKeyName) == true;
end;
local AIMBOT_TARGET_BODY_PARTS = {Head = {'Head'}, Torso = {'HumanoidRootPart', 'UpperTorso', 'Torso', 'LowerTorso'}, Legs = {'LeftUpperLeg', 'RightUpperLeg', 'LeftLeg', 'RightLeg', 'LeftLowerLeg', 'RightLowerLeg'}};
local function findTargetPartInModel(targetModelInstance, desiredPartGroup)
local candidatePartNames = AIMBOT_TARGET_BODY_PARTS[desiredPartGroup];
