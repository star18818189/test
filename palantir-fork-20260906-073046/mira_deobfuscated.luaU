function Features_Combat_Objects_AnimatorDefender__a2Verdict(self, track, animId, checkConfig)
    local now = os.clock()
    local entity = self.entity
    local entityName = entity and entity.Name or "Unknown"

    -- Initialize tracking state if missing
    self._a2Accepted = self._a2Accepted or {}
    self._a2Arrivals = self._a2Arrivals or {}
    self._a2Real = self._a2Real or {}
    self._apbAnimTimestamps = self._apbAnimTimestamps or {}

    local lastAcceptedTime = self._a2Accepted[animId] or 0
    local timeSinceLast = now - lastAcceptedTime

    -- 1. Check Priority Spoofing (Enemy lowered animation priority to Core/Idle to bypass detection)
    if track and track.Priority ~= Enum.AnimationPriority.Action then
        -- Enemy has modified their priority; force-accept track as an attack
        self:__apbEvidenceEvent("Priority Spoof", string.format("Priority %s spoofed on %s", tostring(track.Priority), animId))
        self._a2Accepted[animId] = now
        return "clear"
    end

    -- 2. Check Weight Spoofing & Weight Ramping
    if track and track.WeightCurrent < 0.1 then
        self:__apbEvidenceEvent("Weight Target", string.format("Suppressed animation weight (%.3f) on %s", track.WeightCurrent, animId))
        self._a2Accepted[animId] = now
        return "clear"
    end

    -- 3. Check Track Churn (Spamming multiple fake animation tracks to flood defender)
    table.insert(self._apbAnimTimestamps, now)
    -- Prune timestamps older than 2 seconds
    for i = #self._apbAnimTimestamps, 1, -1 do
        if now - self._apbAnimTimestamps[i] > 2.0 then
            table.remove(self._apbAnimTimestamps, i)
        end
    end
    if #self._apbAnimTimestamps >= 6 then
        self:__apbEvidenceEvent("Churn", string.format("High animation churn detected (%d tracks/2s)", #self._apbAnimTimestamps))
        self._a2Accepted[animId] = now
        return "clear"
    end

    -- 4. Check Rapid Stop-and-Replay Kill
    if timeSinceLast < 0.08 then
        self:__apbEvidenceEvent("Stop+Replay Kill", string.format("Micro-replay detected (%.3fs)", timeSinceLast))
        self._a2LastDecoy = now
        return "decoy"
    end

    -- Standard attack accepted
    self._a2Accepted[animId] = now
    return "clear"
end

